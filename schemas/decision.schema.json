{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase41/decision.schema.json",
  "title": "Decision",
  "type": "object",
  "required": ["decision_id", "title", "context", "objective", "constraints", "evidence", "options", "assumptions", "risks", "uncertainty", "version", "created_at", "updated_at"],
  "properties": {
    "decision_id": {"type":"string","minLength":1}, "title":{"type":"string"},
    "context":{"type":"object"}, "objective":{"type":"object"}, "constraints":{"type":"array","items":{"type":"object"}},
    "evidence":{"type":"array","items":{"type":"object","required":["evidence_id","state"],"properties":{"evidence_id":{"type":"string"},"state":{"enum":["KNOWN","ESTIMATED","UNCERTAIN","CONTESTED","UNKNOWN"]}}}},
    "options":{"type":"array","minItems":1,"items":{"type":"object","required":["option_id","label"]}},
    "selected_option":{"type":["object","null"]}, "assumptions":{"type":"array","items":{"type":"object"}},
    "risks":{"type":"array","items":{"type":"object"}}, "uncertainty":{"enum":["KNOWN","ESTIMATED","UNCERTAIN","CONTESTED","UNKNOWN"]},
    "authorization":{"type":["object","null"]}, "expected_outcome":{"type":["object","null"]}, "actual_outcome":{"type":["object","null"]},
    "decision_quality":{"type":["string","null"]}, "version":{"type":"integer","minimum":1},
    "created_at":{"type":"string"}, "updated_at":{"type":"string"}
  },
  "additionalProperties": false
}